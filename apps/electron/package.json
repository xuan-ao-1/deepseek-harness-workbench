{
  "name": "@dsh-workbench/electron-app",
  "version": "0.1.1",
  "private": true,
  "description": "Electron application carrier for DeepSeek Harness Workbench",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "electron .",
    "dist": "electron-builder --config ../../build/installer/electron-builder.yml --win",
    "dev": "concurrently -k -n tsc,electron-c \"tsc -p tsconfig.json -w\" \"electronmon .\""
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "concurrently": "^10.0.4",
    "electron": "^33.2.0",
    "electron-builder": "^26.0.12",
    "electronmon": "^2.0.4",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.0-rc.6"
  }
}
